<file path="frontend/src/Styles/theme.css">
:root {
  /* ==========================================================================
     1. PALETTE DE COULEURS OFFICIELLE (Logo Rabat Région Mobilité)
     ========================================================================== */
  --color-primary: #003566;           /* Bleu Nuit / Navy principal RRM */
  --color-primary-dark: #001E3D;      /* Deep Navy hover & active states */
  --color-primary-light: #EBF3FA;     /* Soft blue background / active badges */

  --color-secondary: #FFC300;         /* Or / Ambre logo RRM */
  --color-secondary-dark: #E0A800;
  --color-secondary-light: #FFF8E5;   /* Warm highlight background */

  --color-accent: #982B5E;            /* Prune / Magenta accent */
  --color-accent-light: #FBF0F5;      /* Alertes & highlight */

  /* ==========================================================================
     2. COULEURS NEUTRES & SURFACES
     ========================================================================== */
  --color-text: #1E293B;              /* Slate 800 - Texte principal */
  --color-text-muted: #64748B;        /* Slate 500 - Secondaire */
  --color-bg: #F4F6FA;                /* Fond d'application moderne */
  --color-surface: #FFFFFF;           /* Cards, Modals, Tables */
  --color-border: #E2E8F0;            /* Bordures subtiles */
  --color-hover: rgba(0, 53, 102, 0.06);

  /* ==========================================================================
     3. TYPOGRAPHIE & ESPACEMENTS
     ========================================================================== */
  --font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;

  /* ==========================================================================
     4. RAYONS DE COURBURE & ELEVATION
     ========================================================================== */
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-full: 9999px;

  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4px 12px -2px rgba(0, 53, 102, 0.08), 0 2px 6px -1px rgba(0, 0, 0, 0.04);
  --shadow-lg: 0 12px 24px -4px rgba(0, 53, 102, 0.12), 0 4px 12px -2px rgba(0, 0, 0, 0.04);
}

/* ==========================================================================
   RESET ET BASE GLOBALE
   ========================================================================== */
body {
  margin: 0;
  font-family: var(--font-family);
  background-color: var(--color-bg);
  color: var(--color-text);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Scrollbar personnalisée */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: var(--radius-full);
}

::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* ==========================================================================
   CLASSES UTILITAIRES RRM
   ========================================================================== */

/* Ligne décorative tricolore RRM */
.rrm-tricolor-bar {
  height: 4px;
  width: 100%;
  background: linear-gradient(
    90deg,
    var(--color-accent) 0%,
    var(--color-secondary) 50%,
    var(--color-primary) 100%
  );
}

/* En-tête / Bannière RRM */
.rrm-header-banner {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: var(--color-surface);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-md);
}

/* Carte avec liseré tricolore */
.rrm-card-accent {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--color-border);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.rrm-card-accent:hover {
  box-shadow: var(--shadow-md);
}

.rrm-card-accent::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(
    90deg,
    var(--color-accent) 0%,
    var(--color-secondary) 50%,
    var(--color-primary) 100%
  );
}
</file>

