  align-items: center;
  gap: 12px;
  padding: 6px 14px;
  border-radius: 20px;
  border: 1px solid #cbd5e1;
  background: #f8fafc;
  cursor: pointer;
  transition: all 0.2s ease;
  user-select: none;
}

.header-user-section:hover {
  background: #ebf3fa;
  border-color: var(--color-primary, #003566);
  box-shadow: 0 2px 8px rgba(0, 53, 102, 0.12);
}

.header-user-info {
  display: flex;
  align-items: center;
  gap: 10px;
}

.header-user-avatar {
  background: var(--color-primary, #003566) !important;
  color: #ffffff !important;
  font-weight: 700;
  box-shadow: 0 2px 6px rgba(0, 53, 102, 0.2);
}

.header-user-text {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.header-user-name {
  color: var(--color-primary-dark, #001e3d);
  font-weight: 600;
  font-size: 14px;
}

.header-user-role {
  color: var(--color-text-muted, #64748b);
  font-size: 11px;
}

.header-role-tag {
  background: var(--color-primary-light, #ebf3fa) !important;
  color: var(--color-primary, #003566) !important;
  border: 1px solid #cbd5e1 !important;
  font-weight: 600;
  border-radius: 12px;
  padding: 2px 10px;
}

.app-sider {
  background: var(--color-primary, #003566) !important;
  box-shadow: 2px 0 8px rgba(0, 0, 0, 0.08);
  position: sticky;
  top: 68px;
  height: calc(100vh - 68px);
  overflow-y: auto;
}

.app-sider-menu {
  background: transparent !important;
  border-inline-end: none !important;
}

.app-sider-menu .ant-menu-item {
  border-radius: 8px !important;
  margin-block: 4px !important;
  font-weight: 500;
}
