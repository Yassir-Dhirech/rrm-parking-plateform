  const navigate = useNavigate();
  const basePath = role ? roleConfig[role].homePath : "";

  const { data, isLoading } = useQuery({
    queryKey: ["abonnements"],
    queryFn: getAbonnementsMock,
  });

  const columns = [
    { title: "Référence", dataIndex: "reference", key: "reference" },
