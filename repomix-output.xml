  if (isLoading || !data) {
    return <Card loading />;
  }

  return (
    <Card title={`Abonnement ${data.reference}`}>
      <Descriptions column={2} bordered>
        <Descriptions.Item label="Statut">
          <StatusBadge statut={data.statut} />
